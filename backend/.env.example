# Chargetrip GraphQL API Credentials
# Get credentials at: https://chargetrip.com/
CHARGETRIP_CLIENT_ID="your_chargetrip_client_id_here"
CHARGETRIP_APP_ID="your_chargetrip_app_id_here"

# AI Orchestration (CrewAI Driver Briefing)
# Get key at: https://platform.openai.com/
OPENAI_API_KEY="your_openai_api_key_here"

# Open Charge Map API Key (Optional)
# Get free key at: https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_API_KEY="your_openchargemap_api_key_here"

# Application Settings
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
